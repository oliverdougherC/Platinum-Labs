# Homelab Homepage — example environment.
# Copy to `.env.local` (dev) or `.env` (docker compose) and fill in real values.
# NEVER commit real secrets. The app boots fully in fake-data mode with everything
# below left blank.
#
# Connector fields are validated TOGETHER: a URL without its API key (or a qB URL
# without credentials) is reported as a misconfiguration, not silently ignored.

# Master data switch: "fake" (deterministic simulator) or "live" (real connectors).
HOMELAB_DATA_MODE=fake

# Front-end renderer: "topology" keeps the current V2.1 surface (default);
# "fabric" enables the feature-flagged V3 server fabric. This is server-owned
# configuration and is intentionally not exposed as a production client toggle.
HOMELAB_UI_MODE=topology

# Optional declared V3 control/dependency relationships. These are rendered as
# quiet control-plane links, never as measured byte throughput. Identifiers are
# bounded safe node ids such as service:sonarr, service:jellyfin, pool:DataStore,
# and host:control.
# HOMELAB_FABRIC_RELATIONSHIPS=[{"from":"service:sonarr","to":"service:jellyfin","kind":"control","label":"library refresh"}]
HOMELAB_FABRIC_RELATIONSHIPS=

# Which fake scenario to render in fake mode (fake mode only):
#   idle | direct-play | transcode | multi-session | downloads | seeding | seed-only |
#   importing | radarr-import | same-pool-import | cross-pool-import |
#   gpu-workload | pool-scrub | docker-unavailable | relationship-map | stalled |
#   connector-unavailable | stale | zfs-warning | zfs-degraded | unconfigured |
#   active | attention | container-mixed |
#   container-field-real | container-field-stress
HOMELAB_FAKE_SCENARIO=active

# Force the dev scenario switcher on in a production build (screenshots/e2e). 0|1.
HOMELAB_ENABLE_DEV_CONTROLS=0

# Disable Next.js's own anonymous telemetry. No third-party analytics are used.
NEXT_TELEMETRY_DISABLED=1

# Local SQLite history/event store (bounded, auto-migrated on boot).
# Defaults to ./data/homelab.db; in Docker this is /data/homelab.db on a volume.
HOMELAB_DB_PATH=./data/homelab.db

# Optional docker-compose.production.yml topology helpers:
# - Keep the dashboard bound to localhost unless a reverse proxy/Tailscale fronts it.
# - Join the external service networks your existing media/Jellyfin stacks already own.
HOMEPAGE_BIND_ADDRESS=127.0.0.1
HOMEPAGE_PORT=3000
HOMEPAGE_VOLUME_NAME=homelab-homepage-data
MEDIA_NETWORK_NAME=media_default
JELLYFIN_NETWORK_NAME=jellyfin_default

# Browser-facing quick links, as JSON. These are URLs YOUR BROWSER opens and are
# deliberately separate from the server-side connector URLs below — the dashboard
# may be opened from a laptop while services run on another host. Only http/https
# are accepted. Example:
# HOMELAB_QUICK_LINKS=[{"label":"Jellyfin","href":"https://jellyfin.example.lan"},{"label":"Sonarr","href":"https://sonarr.example.lan"}]
HOMELAB_QUICK_LINKS=

# --- Jellyfin --- (URL + API key; for compose production, prefer Docker DNS like
# http://jellyfin:8096 on the external Jellyfin network instead of a host IP)
JELLYFIN_URL=
JELLYFIN_API_KEY=
# Exact Docker container name used for measured Jellyfin egress/block-I/O.
# This is an explicit attribution boundary; names are never guessed.
HOMELAB_JELLYFIN_CONTAINER=

# --- Sonarr --- (URL + API key; on a shared media network this is typically
# http://sonarr:8989)
SONARR_URL=
SONARR_API_KEY=

# --- Radarr --- (URL + API key; on a shared media network this is typically
# http://radarr:7878)
RADARR_URL=
RADARR_API_KEY=

# --- qBittorrent --- (URL + username + password, all three required; use the VPN
# sidecar/WebUI container DNS name when qB is behind gluetun)
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# --- Seerr / Jellyseerr (integrated media search + one-click requests) ---
# Optional. When set, the dashboard gains a "Request media" search surface that
# talks to Seerr server-side. The API key is ADMINISTRATOR-LEVEL for Seerr:
# it can approve requests and read all settings. It stays server-only — it is
# never sent to the browser, logged, or embedded in errors — but treat the .env
# file accordingly (chmod 600, never commit).
#
# Obtain/rotate the key in Seerr: Settings → General → API Key.
#
# Approval contract: every request created from the dashboard is explicitly
# confirmed APPROVED before the UI reports success (if Seerr returns a pending
# request, the dashboard calls the approval endpoint itself and verifies the
# result). Whether Radarr/Sonarr then auto-searches/downloads is entirely your
# existing Seerr/Radarr/Sonarr configuration — the dashboard neither requires
# nor triggers it.
SEERR_URL=
SEERR_API_KEY=
# Set to 0 to disable the request action while keeping search read-only.
SEERR_REQUESTS_ENABLED=1
# Legacy aliases for operators still on a compatible Jellyseerr instance
# (SEERR_* wins per-field when both are set):
# JELLYSEERR_URL=
# JELLYSEERR_API_KEY=

# --- ZFS storage --- two mutually-exclusive modes:
#
# 1. Helper API (required by the dashboard container — it must never receive
#    /dev/zfs or the host zpool binary): run either the tiny read-only host helper
#    (`scripts/zfs-collector.mjs` / `.py`) or the isolated production Compose
#    sidecar, which alone receives /dev/zfs,
#    and point the dashboard at it. URL + token must be set together; a lone
#    helper field is treated as a misconfiguration and will not fall back to
#    command mode. From a container, use `http://host.docker.internal:9797`
#    with the `extra_hosts: host.docker.internal:host-gateway` mapping (see compose).
ZFS_COLLECTOR_URL=
ZFS_COLLECTOR_TOKEN=

# --- Host telemetry collector (PLA-265) ---
# Deliberate, non-secret host label shown by the topology. The app never infers
# a display name from hostnames, IP addresses, or connector metadata.
HOMELAB_HOST_LABEL=
# The /v1/host endpoint of the collector sidecar. In the production compose
# topology this is the same process as the ZFS collector:
#   HOST_COLLECTOR_URL=http://zfs-collector:9797/v1/host
# Token defaults to ZFS_COLLECTOR_TOKEN when unset.
HOST_COLLECTOR_URL=
HOST_COLLECTOR_TOKEN=
# Optional comma-separated host interfaces for network-rate aggregation. Set
# this on hosts with Docker/Tailscale/other virtual interfaces so the gateway
# represents physical host traffic only (for example: eno1,ens6f0).
HOST_NET_INTERFACES=
# Negotiated physical link capacity in megabits/second (for example 1000 or
# 10000). This calibrates gateway intensity only; unset is shown conservatively
# as unknown capacity and never guessed from a short traffic burst.
HOMELAB_NETWORK_LINK_MBPS=
#
# 2. Direct command mode (only when the container/process runs ON the ZFS host
#    with read access to `zpool`, and only when both helper vars above are unset):
#    set to 1. Executes a FIXED argv, never a shell.
HOMELAB_ZFS_COMMAND=0

# 24h soak reminder: run `npm run soak -- --compose-file docker-compose.yml
# --compose-file docker-compose.production.yml --compose-service homepage` against
# the deployed stack so the harness samples container RSS and DB growth in place.

# Operator-declared media pool name (PLA-275). Import/playback topology flows
# attach only to this pool; unset means flows end at a generic storage node.
HOMELAB_MEDIA_POOL=

# Operator-declared download/staging pool name — the pool qBittorrent writes
# incoming data to (and serves seeds from). With it set, the topology can also
# distinguish a same-pool import (rename/hardlink — shown as local organizing,
# never a bulk transfer) from a cross-pool import (a real copy between pools).
# Unset means downloader storage flows end at a generic storage node; the pool
# is never guessed from I/O activity.
HOMELAB_DOWNLOAD_POOL=
