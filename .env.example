# Homelab Homepage — example environment.
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# The app boots fully in fake-data mode with everything below left blank.

# Master data switch: "fake" (deterministic simulator) or "live" (real connectors).
# Live mode requires the connector work in Milestone 02.
HOMELAB_DATA_MODE=fake

# Optional: which fake scenario to render in fake mode: idle | active | attention
HOMELAB_FAKE_SCENARIO=active

# Disable Next.js's own anonymous telemetry. No third-party analytics are used.
NEXT_TELEMETRY_DISABLED=1

# Local SQLite history/event store (bounded, auto-migrated on boot).
# Defaults to ./data/homelab.db; the directory is created automatically.
HOMELAB_DB_PATH=./data/homelab.db

# --- Jellyfin ---
JELLYFIN_URL=
JELLYFIN_API_KEY=

# --- Sonarr ---
SONARR_URL=
SONARR_API_KEY=

# --- Radarr ---
RADARR_URL=
RADARR_API_KEY=

# --- qBittorrent ---
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# --- ZFS collector ---
# A narrow, read-only host-side collector. The dashboard never runs `zpool`
# from browser-originated input.
ZFS_COLLECTOR_URL=
ZFS_COLLECTOR_TOKEN=
