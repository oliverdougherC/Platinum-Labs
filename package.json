{
  "name": "homelab-homepage",
  "version": "0.1.0",
  "private": true,
  "description": "Ambient, data-rich homelab operations homepage.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "node scripts/audit-policy.mjs --scope=prod",
    "audit:all": "node scripts/audit-policy.mjs --scope=all --report-only",
    "check": "npm run typecheck && npm run lint && npm run test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "deploy": "scripts/deploy-production.sh",
    "soak": "node scripts/soak.mjs",
    "smoke:example-env": "node scripts/smoke-example-env.mjs",
    "compose:prod:config": "HOMEPAGE_ENV_FILE=.env.example MEDIA_NETWORK_NAME=media_default JELLYFIN_NETWORK_NAME=jellyfin_default HOMEPAGE_BIND_ADDRESS=127.0.0.1 HOMEPAGE_PORT=3000 HOMEPAGE_VOLUME_NAME=homelab-homepage-data ZFS_COLLECTOR_TOKEN=placeholder docker compose -f docker-compose.yml -f docker-compose.production.yml --profile zfs-sidecar config",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:prod": "node scripts/screenshots.mjs --prod",
    "screenshots:motion": "node scripts/screenshots.mjs --motion",
    "screenshots:motion:prod": "node scripts/screenshots.mjs --motion --prod",
    "screenshots:performance": "node scripts/screenshots.mjs --performance",
    "screenshots:performance:prod": "node scripts/screenshots.mjs --performance --prod",
    "screenshots:determinism": "node scripts/screenshots.mjs --determinism --prod",
    "screenshots:fabric": "node scripts/screenshots.mjs --fabric",
    "screenshots:fabric:prod": "node scripts/screenshots.mjs --fabric --prod",
    "screenshots:fabric:v3": "node scripts/screenshots.mjs --fabric",
    "screenshots:fabric:v3:prod": "node scripts/screenshots.mjs --fabric --prod",
    "screenshots:fabric:motion:prod": "node scripts/screenshots.mjs --fabric --motion --prod",
    "screenshots:fabric:v3:motion:prod": "node scripts/screenshots.mjs --fabric --motion --prod",
    "screenshots:fabric:performance:prod": "node scripts/screenshots.mjs --fabric --performance --prod",
    "screenshots:fabric:v3:performance:prod": "node scripts/screenshots.mjs --fabric --performance --prod",
    "screenshots:fabric:determinism": "node scripts/screenshots.mjs --fabric --determinism --prod",
    "screenshots:fabric:v3:determinism": "node scripts/screenshots.mjs --fabric --determinism --prod",
    "screenshots:kinetic": "node scripts/screenshots.mjs --kinetic",
    "screenshots:kinetic:prod": "node scripts/screenshots.mjs --kinetic --prod",
    "screenshots:kinetic:motion:prod": "node scripts/screenshots.mjs --kinetic --motion --prod",
    "screenshots:fabric-studies": "node scripts/screenshots.mjs --fabric-studies",
    "screenshots:fabric-studies:prod": "node scripts/screenshots.mjs --fabric-studies --prod",
    "screenshots:fabric-studies:motion:prod": "node scripts/screenshots.mjs --fabric-studies --motion --prod",
    "screenshots:fabric:diagnostics": "node scripts/screenshots.mjs --fabric --prod",
    "screenshots:fabric:diagnostics:prod": "node scripts/screenshots.mjs --fabric --prod",
    "dev:fake": "HOMELAB_DATA_MODE=fake HOMELAB_ENABLE_DEV_CONTROLS=1 next dev -p 3911"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.12",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "jsdom": "^25.0.1",
    "playwright": "^1.54.2",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  }
}
